FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T.helium;
}

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 923;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 923;
    }

    bubbles
    {
        type            fixedValue;
        value           uniform 923;
    }

    outlet
    {
        type            zeroGradient;
    }

    "w_.*"
    {
        type            zeroGradient;
    }

    #include "common"
}
