FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}

heatSource
{
    type        coded;
    cellZone    all;
    field       e.salt;

    codeAddAlphaRhoSup
    #{
        if (!mesh().foundObject<volScalarField>("promptHeatSource"))
        {
            // Read prompt and decay heat sources from the 0 directory

            volScalarField * prompt
            (
                new volScalarField
                (
                    IOobject
                    (
                        "promptHeatSource",
                        "0",
                        mesh(),
                        IOobject::MUST_READ,
                        IOobject::AUTO_WRITE
                    ),
                    mesh()
                )
            );

            volScalarField * decay
            (
                new volScalarField
                (
                    IOobject
                    (
                        "decayHeatSource",
                        "0",
                        mesh(),
                        IOobject::MUST_READ,
                        IOobject::AUTO_WRITE
                    ),
                    mesh()
                )
            );

            // Store them

            mesh().objectRegistry::store(prompt);
            mesh().objectRegistry::store(decay);
        }

        volScalarField& prompt =
            mesh().lookupObjectRef<volScalarField>("promptHeatSource");

        volScalarField& decay =
            mesh().lookupObjectRef<volScalarField>("decayHeatSource");

        // Add to source

        scalarField& heSource = eqn.source();
        const scalarField& V = mesh().V();

        heSource -= (prompt.internalField() + decay.internalField()) * V;
    #};
}
