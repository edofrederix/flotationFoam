FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            basicMultiphaseSystem;

phases          (helium salt);

helium
{
    type            purePhaseModel;
    diameterModel   constant;
    constantCoeffs
    {
        d               1e-3;
    }

    residualAlpha   1e-6;
}

salt
{
    type            purePhaseModel;
    diameterModel   constant;
    constantCoeffs
    {
        d               1e-4;
    }

    residualAlpha   1e-6;
}

blending
{
    default
    {
        type            linear;
        minFullyContinuousAlpha.helium 0.7;
        minPartlyContinuousAlpha.helium 0.3;
        minFullyContinuousAlpha.salt 0.7;
        minPartlyContinuousAlpha.salt 0.3;
    }
    drag
    {
        type            linear;
        minFullyContinuousAlpha.helium 0.7;
        minPartlyContinuousAlpha.helium 0.5;
        minFullyContinuousAlpha.salt 0.7;
        minPartlyContinuousAlpha.salt 0.5;
    }
}

surfaceTension
(
    (helium and salt)
    {
        type            constant;
        sigma           0.07;
    }
);

interfaceCompression
();

aspectRatio
();

drag
(
    (helium in salt)
    {
        type            SchillerNaumann;
        residualRe      1e-3;
    }

    (salt in helium)
    {
        type            SchillerNaumann;
        residualRe      1e-3;
    }

    (helium and salt)
    {
        type            segregated;

        m               0.5;
        n               8;
    }
);

virtualMass
(
    (helium in salt)
    {
        type    constantCoefficient;
        Cvm     0.5;
    }

    (salt in helium)
    {
        type    none;
    }
);

heatTransfer
(
    (helium in salt)
    {
        type    RanzMarshall;
    }

    (salt in helium)
    {
        type    spherical;
    }
);

phaseTransfer
();

lift
();

wallLubrication
();

turbulentDispersion
(
    (helium in salt)
    {
        type            LopezDeBertodano;
        Ctd             1.0;
        residualAlpha   1e-3;
    }

    (salt in helium)
    {
        type    none;
    }
);

// Minimum allowable pressure
pMin            10000;


// ************************************************************************* //
