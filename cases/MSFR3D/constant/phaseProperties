FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      phaseProperties;
}

phases (helium salt);

helium
{
    type            purePhaseModel;

    diameterModel   LogMoM;

    LogMoMCoeffs
    {
        dMax            1e-2;
        dMin            1e-6;

        continuousPhase salt;

        sources
        (

        );
    }

    residualAlpha   1e-6;
}

salt
{
    type            purePhaseModel;

    diameterModel   constant;

    constantCoeffs
    {
        d               1e-4;
    }

    residualAlpha   1e-6;
}

blending
{
    default
    {
        type            linear;
        minFullyContinuousAlpha.helium 0.7;
        minPartlyContinuousAlpha.helium 0.3;
        minFullyContinuousAlpha.salt 0.7;
        minPartlyContinuousAlpha.salt 0.3;
    }

    drag
    {
        type            linear;
        minFullyContinuousAlpha.helium 0.7;
        minPartlyContinuousAlpha.helium 0.5;
        minFullyContinuousAlpha.salt 0.7;
        minPartlyContinuousAlpha.salt 0.5;
    }
}

surfaceTension
{
    helium_salt
    {
        type    constant;
        sigma   0.07;
    }
}

