FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      flotationParticleProperties;
}

rho         1E4;
interface   water_air;

distribution
{
    type        sectionalList;
    diameters   (1e-9 2e-9 4e-9 8e-9 1.6e-8 3.2e-8 6.4e-8 1.28e-7 2.56e-7 5.12e-7 1.024e-6 2.048e-6);
}

particles_in_air
{
    Sct     1.0;

    velocity
    {
        type    passiveTracer;
    }

    diffusivity
    {
        type    constant;
        D       0;
    }

    models
    ();
}

particles_in_water
{
    Sct     1.0;

    velocity
    {
        type    passiveTracer;
    }

    diffusivity
    {
        type    StokesEinstein;
    }

    models
    (
        dispersedBrownianDeposition
        {
            Sh  RanzMarshall;
        }
    );
}
