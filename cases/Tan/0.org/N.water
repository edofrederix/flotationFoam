FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      N.water;
}

dimensions      [0 -3 0 0 0 0 0];

internalField   uniform 1e6;

boundaryField
{
    inlet
    {
        type            inletOutlet;
        phi             phi.water;
        inletValue      $internalField;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        phi             phi.water;
        inletValue      $internalField;
        value           $internalField;
    }
    walls
    {
        type            zeroGradient;
    }
}
