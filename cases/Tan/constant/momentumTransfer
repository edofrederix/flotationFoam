FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransfer;
}

drag
{
    nitrogen_dispersedIn_water
    {
        type            LogMoM;
        mode            quadrature;
        GaussHermite    3;

        drag
        {
            type            SchillerNaumann;
            residualRe      1e-3;
            swarmCorrection
            {
                type        none;
            }
        }
    }

    water_dispersedIn_nitrogen
    {
        type            SchillerNaumann;
        residualRe      1e-3;
        swarmCorrection
        {
            type        none;
        }
    }

    nitrogen_segregatedWith_water
    {
        type            segregated;
        m               0.5;
        n               8;
        swarmCorrection
        {
            type        none;
        }
    }
}


virtualMass
{
    nitrogen_dispersedIn_water
    {
        type            constantCoefficient;
        Cvm             0.5;
    }

    water_dispersedIn_nitrogen
    {
        type            constantCoefficient;
        Cvm             0.5;
    }
}

turbulentDispersion
{
    nitrogen_dispersedIn_water
    {
        type                LopezDeBertodano;
        Ctd                 1.0;
        residualAlpha       1e-3;
    }

    water_dispersedIn_nitrogen
    {
        type                LopezDeBertodano;
        Ctd                 1.0;
        residualAlpha       1e-3;
    }
}

lift
{
    nitrogen_dispersedIn_water
    {
        type            LogMoM;
        mode            quadrature;
        GaussHermite    3;

        lift
        {
            type    Tomiyama;

            aspectRatio
            {
                type    Wellek;
            }
        }

        wallDamping
        {
            type            cosine;
            Cd              1.0;
            zeroWallDist    0;
        }
    }

    water_dispersedIn_nitrogen
    {
        type none;
    }
}

wallLubrication
{
    nitrogen_dispersedIn_water
    {
        type    none;
    }

    water_dispersedIn_nitrogen
    {
        type    none;
    }
}
