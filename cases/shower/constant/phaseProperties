FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            basicMultiphaseSystem;

phases          (gas salt);

gas
{
    type            pureIsothermalPhaseModel;
    diameterModel   constant;
    constantCoeffs
    {
        d   1e-3;
    }

    residualAlpha   1e-6;
}

salt
{
    type            pureIsothermalPhaseModel;
    diameterModel   constant;
    constantCoeffs
    {
        d               1e-2;
    }

    residualAlpha   1e-6;
}

blending
{
    default
    {
        type            linear;
        minFullyContinuousAlpha.gas 0.7;
        minPartlyContinuousAlpha.gas 0.3;
        minFullyContinuousAlpha.salt 0.7;
        minPartlyContinuousAlpha.salt 0.3;
    }
    drag
    {
        type            linear;
        minFullyContinuousAlpha.gas 0.7;
        minPartlyContinuousAlpha.gas 0.5;
        minFullyContinuousAlpha.salt 0.7;
        minPartlyContinuousAlpha.salt 0.5;
    }
}

surfaceTension
(
    (gas and salt)
    {
        type    constant;
        sigma   0.06;
    }
);

interfaceCompression
(
    (gas and salt)
    {
        type    isotropic;
        cAlpha  1;
    }
);

aspectRatio
(
    (gas in salt)
    {
        type            constant;
        E0              1.0;
    }

    (salt in gas)
    {
        type            constant;
        E0              1.0;
    }
);

drag
(
    (gas in salt)
    {
        type            SchillerNaumann;
        residualRe      1e-3;
        swarmCorrection
        {
            type        none;
        }
    }

    (salt in gas)
    {
        type            SchillerNaumann;
        residualRe      1e-3;
        swarmCorrection
        {
            type        none;
        }
    }

    (gas and salt)
    {
        type            segregated;
        m               0.5;
        n               8;
        swarmCorrection
        {
            type        none;
        }
    }
);

virtualMass
(
    (gas in salt)
    {
        type            constantCoefficient;
        Cvm             0.5;
    }

    (salt in gas)
    {
        type            constantCoefficient;
        Cvm             0.5;
    }
);

heatTransfer
();

phaseTransfer
();

lift
(
    (gas in salt)
    {
        type            wallDamped;

        lift
        {
            type    Tomiyama;
        }

        wallDamping
        {
            type            cosine;
            Cd              1.0;
            zeroWallDist    0;
        }
    }

    (salt in gas)
    {
        type            none;
    }
);

wallLubrication
(
    (gas in salt)
    {
        type    Antal;
        Cw1     -0.01;
        Cw2     0.05;
    }

    (salt in gas)
    {
        type    none;
    }
);

turbulentDispersion
(
    (gas in salt)
    {
        type                LopezDeBertodano;
        Ctd                 1.0;
        residualAlpha       1e-3;
    }

    (salt in gas)
    {
        type                LopezDeBertodano;
        Ctd                 1.0;
        residualAlpha       1e-3;
    }
);

// Minimum allowable pressure
pMin            100;


// ************************************************************************* //
