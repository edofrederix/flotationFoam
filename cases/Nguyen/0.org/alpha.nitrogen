FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.nitrogen;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.01;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        phi             phi.nitrogen;
        inletValue      uniform 0.99;
        value           $internalField;
    }
    walls
    {
        type            zeroGradient;
    }
}
