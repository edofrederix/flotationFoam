FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      phaseProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            basicMultiphaseSystem;

phases          (nitrogen water);

nitrogen
{
    type            pureIsothermalPhaseModel;
    diameterModel   constant;
    constantCoeffs
    {
        d               1.64e-4;
    }

    residualAlpha   1e-6;
}

water
{
    type            pureIsothermalPhaseModel;
    diameterModel   constant;
    constantCoeffs
    {
        d               1e-4;
    }

    residualAlpha   1e-6;
}

blending
{
    default
    {
        type            linear;
        minFullyContinuousAlpha.nitrogen 0.7;
        minPartlyContinuousAlpha.nitrogen 0.3;
        minFullyContinuousAlpha.water 0.7;
        minPartlyContinuousAlpha.water 0.3;
    }
    drag
    {
        type            linear;
        minFullyContinuousAlpha.nitrogen 0.7;
        minPartlyContinuousAlpha.nitrogen 0.5;
        minFullyContinuousAlpha.water 0.7;
        minPartlyContinuousAlpha.water 0.5;
    }
}

surfaceTension
(
    (nitrogen and water)
    {
        type            constant;
        sigma           0.06;
    }
);

interfaceCompression
();

aspectRatio
(
    (nitrogen in water)
    {
        type            constant;
        E0              1.0;
    }

    (water in nitrogen)
    {
        type            constant;
        E0              1.0;
    }
);

drag
(
    (nitrogen in water)
    {
        type            SchillerNaumann;
        residualRe      1e-3;
        swarmCorrection
        {
            type        none;
        }
    }

    (water in nitrogen)
    {
        type            SchillerNaumann;

        residualRe      1e-3;
        swarmCorrection
        {
            type        none;
        }
    }

    (nitrogen and water)
    {
        type            segregated;

        m               0.5;
        n               8;
        swarmCorrection
        {
            type        none;
        }
    }
);

virtualMass
(
    (nitrogen in water)
    {
        type            constantCoefficient;
        Cvm             0.5;
    }

    (water in nitrogen)
    {
        type            constantCoefficient;
        Cvm             0.5;
    }
);

heatTransfer
();

phaseTransfer
();

lift
(
    (nitrogen in water)
    {
        type            wallDamped;

        lift
        {
            type    Tomiyama;
        }

        wallDamping
        {
            type            cosine;
            Cd              1.0;
            zeroWallDist    0;
        }
    }

    (water in nitrogen)
    {
        type            none;
    }
);

wallLubrication
(
    (nitrogen in water)
    {
        type    none;
    }

    (water in nitrogen)
    {
        type    none;
    }
);

turbulentDispersion
(
    (nitrogen in water)
    {
        type                LopezDeBertodano;
        Ctd                 1.0;
        residualAlpha       1e-3;
    }

    (water in nitrogen)
    {
        type                LopezDeBertodano;
        Ctd                 1.0;
        residualAlpha       1e-3;
    }
);

// Minimum allowable pressure
pMin            10000;


// ************************************************************************* //
