FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U.salt;
}

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type                mappedInternalValue;
        value               $internalField;
        interpolationScheme cell;
        setAverage          true;
        average             (0 -1.55289 0);
    }

    bubbles
    {
        type            fixedValue;
        value           $internalField;
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        phi             phi.salt;
        value           $internalField;
    }

    walls
    {
        type            noSlip;
    }

    #include "common"
}
