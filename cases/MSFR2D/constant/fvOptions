heatSource
{
    type        coded;
    cellZone    all;
    fields      (e.salt);

    codeAddSup
    #{
        if (!mesh_.foundObject<volScalarField>("promptHeatSource"))
        {
            // Read prompt and decay heat sources from the 0 directory

            volScalarField* prompt
            (
                new volScalarField
                (
                    IOobject
                    (
                        "promptHeatSource",
                        "0",
                        mesh_,
                        IOobject::MUST_READ,
                        IOobject::AUTO_WRITE
                    ),
                    mesh_
                )
            );

            volScalarField* decay
            (
                new volScalarField
                (
                    IOobject
                    (
                        "decayHeatSource",
                        "0",
                        mesh_,
                        IOobject::MUST_READ,
                        IOobject::AUTO_WRITE
                    ),
                    mesh_
                )
            );

            // Store them

            mesh_.objectRegistry::store(prompt);
            mesh_.objectRegistry::store(decay);
        }

        volScalarField& prompt =
            mesh_.lookupObjectRef<volScalarField>("promptHeatSource");

        volScalarField& decay =
            mesh_.lookupObjectRef<volScalarField>("decayHeatSource");

        // Add to source

        scalarField& heSource = eqn.source();
        const scalarField& V = mesh_.V();

        heSource -= (prompt.primitiveField() + decay.primitiveField())*V;
    #};
}

